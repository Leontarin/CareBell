# ─── Frontend Dev Dockerfile ────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install dependencies (non-strict to allow live editing)
COPY package*.json ./
RUN npm install

# Copy the rest of the source
COPY . .

EXPOSE 5173

# Run Vite dev server with hot reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

