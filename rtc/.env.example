# ────────────────────────────────
# LIVEKIT DEV ENVIRONMENT (.env)
# Place this inside: /rtc/.env
# ────────────────────────────────

# API credentials for signing tokens
LIVEKIT_API_KEY=carebell
LIVEKIT_API_SECRET=supersecret

#URLs
LIVEKIT_PUBLIC_URL=http://localhost:5175
LIVEKIT_INTERNAL_URL=http://livekit-dev:7880

# Internal interface for LiveKit inside Docker
LIVEKIT_PORT=7880

# Bind LiveKit to all interfaces
LIVEKIT_BIND=0.0.0.0

# Optional (but recommended): disable TURN for local dev
LIVEKIT_TURN_ENABLED=false