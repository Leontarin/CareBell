#/rtc/rtc.Dockerfile.dev
# ─────────────────────────────────────────────
# LiveKit Server - Development Dockerfile
# Hot reload enabled using --watch
# ─────────────────────────────────────────────
FROM livekit/livekit-server:v1.9.1

WORKDIR /app
COPY . .

EXPOSE 7880

# Correct dev run command
CMD ["--dev", "--config", "/app/livekit.yaml"]
